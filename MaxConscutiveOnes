import java.util.*;
class MaxConscutiveOnes{
    public int findMaxConscutiveOnes(int[] nums){
        int res =0;
        int count =0;
        for(int i=0;i<nums.length;i+){
            if(nums[i] ==0){
                count =0;
            }
            else{
                count++;
            }
            if(res<count){
                res=count;
            }
        }
        return res;
    }
    public static void main(String[] args){
        MaxConscutiveOnes sol=new MaxConscutiveOnes();
        int[] nums = {1,1,0,1,1,1};
        System.out.println(sol.findMaxConscutiveOnes(nums));
    }
}  