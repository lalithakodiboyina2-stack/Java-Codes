import java.util.*;
public class Fibonnaci509{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.next.Int();
        int a=0,b =1;
        System.out.println(a+" +"+b);
        for(int i=0;i<n;i++){
            int c=a+b;
            System.out.println (c);
            a=b;
            b=c;

        }
    }
}